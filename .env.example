# PostgreSQL
POSTGRES_DB=yitu
POSTGRES_USER=yitu
POSTGRES_PASSWORD=
YITU_DATABASE_URL=postgresql+asyncpg://yitu:请替换密码@db:5432/yitu

# Redis 缓存与 Celery 消息队列
YITU_REDIS_URL=redis://redis:6379/0

# 腾讯云 COS 私有知识对象存储
YITU_KNOWLEDGE_STORAGE_BACKEND=s3
YITU_KNOWLEDGE_STORAGE_ROOT=/app/var/knowledge
YITU_KNOWLEDGE_S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
YITU_KNOWLEDGE_S3_BUCKET=
YITU_KNOWLEDGE_S3_REGION=ap-guangzhou
YITU_KNOWLEDGE_S3_ACCESS_KEY=
YITU_KNOWLEDGE_S3_SECRET_KEY=

# MinerU 云端 PDF 解析
YITU_MINERU_BASE_URL=https://mineru.net
YITU_MINERU_TOKEN=
YITU_MINERU_MODEL_VERSION=vlm

# 阿里云百炼 Qwen Embedding
YITU_EMBEDDING_PROVIDER=qwen
YITU_EMBEDDING_BASE_URL=
YITU_EMBEDDING_API_KEY=
YITU_EMBEDDING_MODEL=qwen3.7-text-embedding
YITU_EMBEDDING_DIMENSION=1024

# AI Agent 对话模型（开发环境可使用 fixed，无需外部 API）
YITU_AGENT_MODEL_PROVIDER=fixed
YITU_AGENT_MODEL_BASE_URL=
YITU_AGENT_MODEL_API_KEY=
YITU_AGENT_MODEL_NAME=
YITU_AGENT_MODEL_TIMEOUT_SECONDS=60

# 支付网关（当前默认 mock，记录演示支付流水；上线接支付宝时再切换）
YITU_PAYMENT_PROVIDER=mock
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
