# ============================================================
# 生产环境变量样例。复制为 deploy/.env.production 并填入真实值：
#   cp deploy/.env.production.example deploy/.env.production
# .env.production 已被 .gitignore 忽略，切勿提交。
# 所有应用配置统一使用 YITU_ 前缀（见 backend/src/yitu/platform/config.py）。
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=yitu
POSTGRES_USER=yitu
# 生产强密码：建议 openssl rand -base64 24 生成
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# 容器内网地址，服务名为 db；不要写 127.0.0.1
YITU_DATABASE_URL=postgresql+asyncpg://yitu:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/yitu

# ---- Redis（Celery 消息队列 / 缓存）----
YITU_REDIS_URL=redis://redis:6379/0

# ---- 安全密钥（生产必填，缺失则使用源码里的开发默认值，极其危险）----
# JWT 签名密钥：openssl rand -hex 32
YITU_JWT_SECRET=CHANGE_ME_64_HEX_JWT_SECRET
# 取件码哈希 pepper：openssl rand -hex 32
YITU_PICKUP_CODE_PEPPER=CHANGE_ME_64_HEX_PEPPER
# 生产关闭演示模式（compose 已显式设为 production，这里不再放固定取件码）

# ---- 腾讯云 COS 对象存储（生产知识库 PDF 存储）----
YITU_KNOWLEDGE_STORAGE_BACKEND=s3
YITU_KNOWLEDGE_STORAGE_ROOT=/app/var/knowledge
YITU_KNOWLEDGE_S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
YITU_KNOWLEDGE_S3_BUCKET=your-cos-bucket-name
YITU_KNOWLEDGE_S3_REGION=ap-guangzhou
YITU_KNOWLEDGE_S3_ACCESS_KEY=your-cos-secret-id
YITU_KNOWLEDGE_S3_SECRET_KEY=your-cos-secret-key

# ---- MinerU 云端 PDF 解析 ----
YITU_MINERU_BASE_URL=https://mineru.net
YITU_MINERU_TOKEN=your-mineru-token
YITU_MINERU_MODEL_VERSION=vlm

# ---- 阿里云百炼 Embedding（知识库 + 语义记忆向量）----
YITU_EMBEDDING_PROVIDER=qwen
YITU_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
YITU_EMBEDDING_API_KEY=your-dashscope-api-key
YITU_EMBEDDING_MODEL=qwen3.7-text-embedding
YITU_EMBEDDING_DIMENSION=1024

# ---- 可选：Rerank 精排（不配则自动跳过精排，回退融合排序）----
YITU_RERANK_PROVIDER=
YITU_RERANK_BASE_URL=
YITU_RERANK_API_KEY=
YITU_RERANK_MODEL=gte-rerank

# ---- AI Agent 对话模型（生产用真实 OpenAI 兼容服务，如 DeepSeek）----
YITU_AGENT_MODEL_PROVIDER=openai_compatible
YITU_AGENT_MODEL_BASE_URL=https://api.deepseek.com/v1
YITU_AGENT_MODEL_API_KEY=your-llm-api-key
YITU_AGENT_MODEL_NAME=deepseek-chat
YITU_AGENT_MODEL_TIMEOUT_SECONDS=60
# 多副本必须用 postgres 共享草稿子图状态（compose 已强制）
YITU_AGENT_CHECKPOINTER_BACKEND=postgres

# ---- 支付（上线前保持 mock；接支付宝时切换并补全）----
YITU_PAYMENT_PROVIDER=mock
YITU_ALIPAY_APP_ID=
YITU_ALIPAY_PRIVATE_KEY=
YITU_ALIPAY_PUBLIC_KEY=
YITU_ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/payments/alipay/notify
